{
  "productName": "Cy KafClient",
  "version": "0.1.4",
  "identifier": "com.cykaf.client",
  "build": {
    "frontendDist": "../bootstrap"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/cy-kaf-client"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5QkYxQTM0QTkxQjBGMDQKUldRRUR4dXBOQnEvV1dFZ0FGS3Faam9ldnk2MjAzVTFlTFdMeFpJTU9zY3pvd0ZiU1NJNnliSXMK",
      "endpoints": [
        "https://github.com/stefaniekepler/cy-kaf-client/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
